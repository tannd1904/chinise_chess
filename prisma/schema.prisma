datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  eloRating    Int      @default(1200)
  wins         Int      @default(0)
  losses       Int      @default(0)
  draws        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  redMatches   Match[]  @relation("RedPlayer")
  blackMatches Match[]  @relation("BlackPlayer")

  @@index([email])
  @@index([eloRating])
}

model Match {
  id                String      @id @default(uuid())
  roomCode          String
  redPlayerId       String?
  blackPlayerId     String?
  redPlayerName     String
  blackPlayerName   String
  status            String      @default("FINISHED")
  result            String      // RED_WIN, BLACK_WIN, DRAW
  winnerColor       String?     // RED, BLACK, null
  terminationReason String
  timeControl       String
  totalMoves        Int         @default(0)
  startedAt         DateTime
  endedAt           DateTime
  createdAt         DateTime    @default(now())

  redPlayer         User?       @relation("RedPlayer", fields: [redPlayerId], references: [id], onDelete: SetNull)
  blackPlayer       User?       @relation("BlackPlayer", fields: [blackPlayerId], references: [id], onDelete: SetNull)
  moves             MatchMove[]

  @@index([redPlayerId])
  @@index([blackPlayerId])
  @@index([createdAt])
}

model MatchMove {
  id            String   @id @default(uuid())
  matchId       String
  moveNumber    Int
  playerColor   String   // RED, BLACK
  fromX         Int
  fromY         Int
  toX           Int
  toY           Int
  capturedPiece String?
  createdAt     DateTime @default(now())

  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, moveNumber])
}

